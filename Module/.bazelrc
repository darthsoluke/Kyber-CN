build --cxxopt='/std:c++latest'
build --cxxopt='/Zc:__cplusplus'
build --cxxopt=/utf-8
build --copt=/wd4312 # gRPC warnings about pointer size
build --copt=/wd4244 # gRPC warnings about pointer size
build --copt=/wd4141 # Protobuf warnings about repeated 'inline'
build --copt=/utf-8

common --nolegacy_external_runfiles
common --experimental_sibling_repository_layout

build:debug --copt=/RTC1 # Runtime memory error checks

build:release --compilation_mode=opt
build:release --copt=/Z7 # Generate complete debugging information
build:release --copt=/O2 # Optimization: Maximize Speed (Release mode)
build:release --copt=/FS # Enable file-level locking for PDB files
build:release --copt=/MP # Enable parallel compilation
build:release --copt=/guard:cf- # Wine loader compatibility for injected DLLs
build:release --copt=/guard:ehcont- # Wine loader compatibility for injected DLLs
build:release --copt=/volatileMetadata- # Wine loader compatibility for injected DLLs
build:release --linkopt=/DEBUG # Generate debug info
build:release --linkopt=/GUARD:NO # Wine loader compatibility for injected DLLs
build:release --linkopt=/EMITVOLATILEMETADATA:NO # Wine loader compatibility for injected DLLs
build:release --linkopt=/DYNAMICBASE:NO # Wine loader compatibility for injected DLLs
build:release --linkopt=/HIGHENTROPYVA:NO # Wine loader compatibility for injected DLLs
build:release --linkopt=/BASE:0x00006FFFF0000000 # Wine loader compatibility for injected DLLs
